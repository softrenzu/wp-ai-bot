version: "3.9"

services:
  llama:
    image: ghcr.io/ggerganov/llama.cpp:full
    container_name: llama-server
    command: >
      --server
      -m ${MODEL_FILE}
      -c 1024
      -n 256
      --host 0.0.0.0
      --port 8080
    volumes:
      - ./models:/models
    ports:
      - "8080:8080"
    env_file:
      - .env

  bot:
    build: ./bot
    env_file:
      - .env
    depends_on:
      - llama
    # 手動で1回だけ動かしたいとき用:
    #   docker-compose run --rm bot
    command: ["python", "main.py"]

  scheduler:
    build: ./bot
    env_file:
      - .env
    depends_on:
      - llama
    command: ["python", "scheduler.py"]
    restart: unless-stopped
